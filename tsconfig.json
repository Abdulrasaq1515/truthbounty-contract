{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "hardhat.config.ts",
    "hardhat.vrm.config.ts",
    "scripts",
    "test",
    "types"
  ],
  "exclude": ["node_modules", "lib", "indexer", "meta-tx"]
}
