{
  "schemaVersion": 1,
  "description": "Pinned toolchain and scope for the zero-new-finding static analysis baseline. Changing any value under toolchain or scope requires re-triaging config/slither-baseline.json in the same commit.",
  "toolchain": {
    "slither": "0.11.6",
    "cryticCompile": "0.4.2",
    "solc": "0.8.28",
    "python": "3.12"
  },
  "requirementsFile": "config/requirements-static-analysis.txt",
  "scope": {
    "target": "contracts/v2",
    "filterPaths": [
      "lib",
      "node_modules",
      "test",
      "script",
      "contracts/mocks",
      "contracts/upgrade",
      "contracts/bootstrap",
      "contracts/performance"
    ],
    "excludeBySeverity": []
  },
  "baselineFile": "config/slither-baseline.json",
  "reportFile": "out/static-analysis/slither-report.json",
  "suppressibleDispositions": [
    "false-positive",
    "accepted-risk"
  ],
  "minJustificationLength": 80
}
