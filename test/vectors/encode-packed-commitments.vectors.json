      "v2ProposalId": "0x93eb8e998bd92e62312bac5c251fa484735589510ee38c01de4ec82ff4de18bc"
    },
    {
      "caseId": "delimiter-shift",
      "note": "SupplyChainAttestationAnchor joins free-form fields with '|'. Without a guard, name='a|b',version='c' and name='a',version='b|c' produce the same record and read back as the latter. The anchor now rejects '|' in every free-form field (V2Errors.AttestationFieldContainsDelimiter).",
      "delimiter": "|",
      "left": { "name": "a|b", "version": "c" },
      "right": { "name": "a", "version": "b|c" },
      "record": "a|b|c"
    }
  ],
