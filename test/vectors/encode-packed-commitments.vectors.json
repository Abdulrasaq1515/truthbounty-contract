      "left": ["ab", "c"],
      "right": ["a", "bc"],
      "packedHex": "0x616263",
      "packedDigest": "0x4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45",
