{
  "schema": "truthbounty/encode-packed-vectors/v1",
  "issue": "V2-SC-160",
  "description": "Cross-tool digest vectors for packed-encoding commitments. Every digest is recomputed with ethers by scripts/check-encode-packed-vectors.mjs and mirrored in contracts/test/EncodePackedCommitmentVectors.sol, which test/v2/EncodePackedCommitments.t.sol checks against the live contracts. Verify with: node scripts/check-encode-packed-vectors.mjs",
  "schemes": [
    {
      "id": "operationId.v2",
      "consumer": "contracts/libraries/CanonicalEventLibrary.sol#computeOperationId",
      "tagConstant": "CanonicalEventLibrary.OPERATION_ID_SCHEME_V2",
      "tagPreimage": "TruthBounty.CanonicalEventLibrary.operationId.v2",
      "tag": "0x8c64e5c5cfa178c0038b286a8308bc8123d76ea44174910a08ded4a9b9cf443e",
      "abiTypes": ["bytes32", "string", "uint256", "address"],
      "encoding": "keccak256(abi.encode(OPERATION_ID_SCHEME_V2, domain, nonce, actor))",
      "replaces": "keccak256(abi.encodePacked(domain, nonce, actor))"
    },
    {
      "id": "upgradeHash.v2",
      "consumer": "contracts/upgrade/UpgradeController.sol#proposeUpgrade (UpgradeProposal.upgradeHash)",
      "tagConstant": "UpgradeController.UPGRADE_HASH_SCHEME_V2",
      "tagPreimage": "TruthBounty.UpgradeController.upgradeHash.v2",
      "tag": "0x811553cc20c92c3707264c87d19f1ed9f2ca671214b9d6a3ecc419c6a7523b5c",
      "abiTypes": ["bytes32", "address", "address", "address", "string", "uint8", "uint256"],
      "encoding": "keccak256(abi.encode(UPGRADE_HASH_SCHEME_V2, targetContract, currentImplementation, newImplementation, version, upgradeType, block.timestamp))",
      "replaces": "keccak256(abi.encodePacked(targetContract, currentImplementation, newImplementation, version, upgradeType, block.timestamp))"
    },
    {
      "id": "proposalId.v2",
      "consumer": "contracts/upgrade/UpgradeController.sol#proposeUpgrade (return value, UpgradeProposed event, proposal key)",
      "tagConstant": "UpgradeController.UPGRADE_PROPOSAL_ID_SCHEME_V2",
      "tagPreimage": "TruthBounty.UpgradeController.proposalId.v2",
      "tag": "0x22015412ba7af32cf094b083b6dc19f23039090bf7813354d4d610afddfc54e4",
      "abiTypes": ["bytes32", "address", "address", "string", "address", "uint256"],
      "encoding": "keccak256(abi.encode(UPGRADE_PROPOSAL_ID_SCHEME_V2, targetContract, newImplementation, version, proposer, block.timestamp))",
      "replaces": "keccak256(abi.encodePacked(\"UPGRADE\", targetContract, newImplementation, version, proposer, block.timestamp))"
    }
  ],
  "collisions": [
    {
      "caseId": "adjacent-dynamic-strings",
      "note": "Two variable-length operands side by side: the boundary between them is not encoded, so ('ab','c') and ('a','bc') pack to the same bytes. Typed abi.encode length-prefixes each operand and separates them.",
