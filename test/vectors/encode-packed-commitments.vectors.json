    },
    {
      "caseId": "cross-schema-operation-id-vs-upgrade-proposal-id",
      "note": "The retired V1 operation id keccak256(abi.encodePacked(domain, nonce, actor)) takes a caller-chosen domain string. Choosing domain = 'UPGRADE' || target || newImplementation || version and splitting proposer || timestamp into (nonce, actor) reproduces the retired V1 upgrade proposal id byte for byte. Under the V2 schemes the two ids differ because each preimage starts with its own 32-byte scheme tag.",
      "legacyProposalId": {
        "packedTypes": ["string", "address", "address", "string", "address", "uint256"],
        "values": [
          "UPGRADE",
          "0x0000000000000000000000000000000000000100",
          "0x0000000000000000000000000000000000000200",
          "1.0.0",
          "0x0000000000000000000000000000000000000001",
          "1700000000"
        ]
      },
